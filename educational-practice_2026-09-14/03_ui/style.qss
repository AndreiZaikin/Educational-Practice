QMainWindow {
    background-color: #ffffff;
}

QWidget#header {
    background-color: #ffffff;
}

QLabel#headerTitle {
    font-size: 16px;
    font-weight: bold;
    color: #2b2b2b;
}

QScrollArea {
    border: none;
    background-color: #ffffff;
}

QFrame#cardsPanel {
    background-color: #ffffff;
    border: 1px solid #a0a0a0;
}

QWidget#cardsContainer {
    background-color: #ffffff;
}

QFrame#partnerCard {
    background-color: #ffffff;
    border: 1px solid #a0a0a0;
    border-radius: 2px;
}

QLabel#partnerTitle {
    font-size: 16px;
    color: #2b2b2b;
}

QLabel#partnerDetail {
    font-size: 12px;
    color: #5a5a5a;
}

QLabel#partnerDiscount {
    font-size: 16px;
    color: #2b2b2b;
}